# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://roadmap:roadmap@localhost:5432/roadmap

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=

# OAuth apps (callback URLs: http://localhost:3000/api/auth/callback/google and .../github)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
